# ============================================================
# Syro — configuration (optionnelle)
# Copier en .env pour modifier les valeurs par défaut :  cp .env.example .env
# Sans .env, Syro démarre avec Ollama en local (gratuit).
# ============================================================

# ----- LLM -------------------------------------------------------------
# ollama (local, gratuit, défaut) | openai
LLM_PROVIDER=ollama
CHAT_MODEL=llama3.2
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Pour OpenAI, décommenter :
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# QDRANT_COLLECTION_NAME=syro_chunks_openai   # nouvelle dimension = nouvelle collection

# ----- Compte de démo (créé au 1er démarrage) ----------------------------
SYRO_ADMIN_EMAIL=demo@syro.local
SYRO_ADMIN_PASSWORD=syro-demo

# ----- Retrieval -------------------------------------------------------
PERFORMANCE_MODE=quality          # quality (reranker) | fast (sans reranker)
RETRIEVAL_TOP_K=20                # candidats par retriever (dense, BM25)
RERANK_TOP_K=5                    # chunks envoyés au LLM
RERANK_MIN_SCORE=0.02             # sous ce score cross-encoder : chunk écarté
RRF_K=60

# Couches optionnelles (désactivées par défaut — mesurer avant d'activer)
ENABLE_QUERY_REWRITING=false
ENABLE_HYDE=false
ENABLE_CRAG=false
ENABLE_SELF_RAG=false
ENABLE_QUERY_DECOMPOSITION=false
ENABLE_SEMANTIC_CACHE=false

# ----- Sécurité --------------------------------------------------------
# Vide = secret aléatoire généré et conservé dans le volume de données.
# SECRET_KEY=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Observabilité (optionnel) ----------------------------------------
MLOPS_ENABLED=true
LANGFUSE_ENABLED=false
LOG_LEVEL=INFO

# ----- Développement local (hors Docker : make dev) -----------------------
# QDRANT_URL=http://localhost:6333
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CELERY_TASK_ALWAYS_EAGER=true   # ingestion sans worker Celery
