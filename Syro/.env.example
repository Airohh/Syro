# ============================================================
# Syro — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ----- Core -----
APP_NAME=Syro
DEBUG=false
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXP_MINUTES=1440

# ----- LLM Provider -----
# Choose: "ollama" (local, free) or "openai" (cloud)
LLM_PROVIDER=ollama
CHAT_MODEL=llama3.2
CHAT_TEMPERATURE=0.2
# Resilience: timeouts (seconds) and automatic retries on transient errors
LLM_TIMEOUT=60
EMBEDDING_TIMEOUT=30
LLM_MAX_RETRIES=2
# Circuit breaker: after N consecutive failures, fail fast for the reset period
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_USE_GPU=true

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ----- Embeddings -----
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_SIZE=1000

# ----- Retrieval -----
PERFORMANCE_MODE=quality          # fast | quality | adaptive
HYBRID_SEARCH_ALPHA=0.7           # 0.0 = BM25 only, 1.0 = vector only
RETRIEVAL_TOP_K=10                # candidates before reranking
RERANK_TOP_K=5                    # final chunks sent to LLM
ENABLE_RERANKING=true
RERANK_WEIGHT=0.7                 # weight of reranker score in final score

# Adaptive mode thresholds (ms)
ADAPTIVE_FAST_THRESHOLD_MS=3000
ADAPTIVE_QUALITY_THRESHOLD_MS=1500
ADAPTIVE_WINDOW_SIZE=5

# ----- Database -----
DB_PATH=db/syro.db

# ----- Qdrant -----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=syro_chunks
ENABLE_DOMAIN_ROUTING=true

# ----- Redis / Celery -----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false    # set to true to disable Celery (sync fallback)

# ----- MLOps -----
MLOPS_ENABLED=true
MLOPS_EXPERIMENT_NAME=syro_rag
MLFLOW_TRACKING_URI=              # leave empty for local file store

# Alerting (optional)
MLOPS_ALERTS_ENABLED=false
MLOPS_ALERTS_EMAIL_ENABLED=false
MLOPS_ALERTS_WEBHOOK_ENABLED=false
MLOPS_ALERTS_SMTP_HOST=
MLOPS_ALERTS_SMTP_PORT=587
MLOPS_ALERTS_SMTP_USER=
MLOPS_ALERTS_SMTP_PASSWORD=
MLOPS_ALERTS_EMAIL_FROM=
MLOPS_ALERTS_EMAIL_TO=
MLOPS_ALERTS_WEBHOOK_URL=

# ----- Observability -----
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
METRICS_ENABLED=true
TRACING_ENABLED=false             # requires an OTLP-compatible collector
OTLP_ENDPOINT=                    # e.g. http://localhost:4317

# ----- Security -----
# In production: comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
MAX_FILE_SIZE_MB=100
MAX_TEXT_SIZE_MB=10
ENABLE_FILE_VALIDATION=true
ENABLE_SECURITY_HEADERS=true
